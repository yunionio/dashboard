/**
 * Environment Variables for Development
 * author: houjiazong <houjiazong@gmail.com>
 * date: 2019/08/08
 * Tips：请不要直接修改此配置文件，如有修改需求请在根目录新建.env.development.local文件修改
 */

VUE_APP_BASE_API=/api
# 「新版尝鲜」：默认同域 + /v2 + 当前 path（8081 代理到新版 Vite 8082）；勿以斜杠结尾
# VUE_APP_NEW_APP_URL=http://localhost:8081
VUE_APP_NEW_VERSION_PREFIX=/v2
VUE_APP_WEB_CONSOLE_PATH=http://localhost:4000/web-console/
VUE_APP_PLATFORM=cmp_public
VUE_APP_ENABLE_ICON=true
VUE_APP_SHOW_SWITCH_VERSION=false
# 开发环境是否按 localStorage 偏好自动 / ↔ /v2 跳转（默认 false；生产 build 始终开启）
VUE_APP_OC_VERSION_REDIRECT_IN_DEV=false
# 偏好旧版且开启跳转时，新版 dev 跳旧版的根（与 Vite 工程 VITE_LEGACY_APP_URL 同义）
# VUE_APP_LEGACY_APP_URL=http://localhost:8081
